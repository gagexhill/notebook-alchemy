# Notebook Alchemy environment (example). Copy to .env, which git ignores.
# Never commit real values. `notebook-alchemy setup` writes this file for you.

# Optional. Without it, the books hold every video's words, sorted by title words, with no AI labels.
# Make a key at https://platform.claude.com/settings/keys (the API is paid; a workspace of its own
# with a monthly spend limit caps what the key can cost).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# The notebooklm profile whose Google account receives uploads. `notebook-alchemy setup` sets it;
# `notebook-alchemy status` shows the account. Independent of the Claude Console account.
# ALCHEMY_NOTEBOOKLM_PROFILE=default

# Optional overrides.
# Another model must accept thinking turned off at low effort, as Claude Haiku 5.5 does.
# ALCHEMY_MODEL=claude-haiku-5-5
# Caption languages to try first, in order (YouTube language codes). Without a match, the
# uploader's own captions are used in any language, then automatic ones.
# ALCHEMY_CAPTION_LANGUAGES=en,en-US,en-GB
# Parallel transcript downloads.
# ALCHEMY_MAX_CONCURRENCY=4
# A browser yt-dlp may read your YouTube sign-in from when captions are blocked (chrome, edge,
# firefox, brave). On Windows, Chrome and Edge often lock or encrypt it; the run says so.
# ALCHEMY_COOKIES_BROWSER=
# ALCHEMY_CACHE_DIR=~/.notebook-alchemy/cache
# A notebooklm session file to use instead of a profile (then --profile cannot be used).
# ALCHEMY_SESSION_FILE=
# ALCHEMY_LOG_LEVEL=INFO
