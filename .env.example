# Notebook Alchemy environment (example). Copy to .env, which git ignores.
# Never commit real values. `notebook-alchemy setup` writes this file for you.

# Optional. Without it, volumes are offline indexes (titles only) and clustering uses keywords.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# The notebooklm profile whose Google account receives uploads. `notebook-alchemy setup` sets it;
# `notebook-alchemy status` shows the account. Independent of the account that owns the Gemini key.
# ALCHEMY_NOTEBOOKLM_PROFILE=default

# Optional overrides.
# ALCHEMY_GEMINI_MODEL=gemini-3.8-flash
# Used when the model above is overloaded or unavailable. Set it empty to turn the fallback off.
# ALCHEMY_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Caption languages to try first, in order (YouTube language codes). Without a match, the
# uploader's own captions are used in any language, then automatic ones.
# ALCHEMY_CAPTION_LANGUAGES=en,en-US,en-GB
# Parallel transcript downloads.
# ALCHEMY_MAX_CONCURRENCY=4
# ALCHEMY_VAULT_PATH=./vault
# ALCHEMY_CACHE_DIR=~/.notebook-alchemy/cache
# A notebooklm session file to use instead of a profile (then --profile cannot be used).
# ALCHEMY_SESSION_FILE=
# ALCHEMY_LOG_LEVEL=INFO
