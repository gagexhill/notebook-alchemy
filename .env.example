# Notebook Alchemy Environment Configuration (Example)
# Copy this file to .env and configure for your local environment.
# NOTE: .env is strictly ignored by git and must never be committed.

# Notebook Alchemy Engine
ALCHEMY_ENV=development
ALCHEMY_LOG_LEVEL=INFO

# Storage & Local Vault Configuration
ALCHEMY_VAULT_PATH=./vault
ALCHEMY_STATE_DIR=./.notebooklm

# Optional Headless / Session Configuration
# Do not store production credentials or active session cookies in source control.
ALCHEMY_SESSION_FILE=./.notebooklm/session.json
